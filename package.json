{
  "name": "tiffin-period",
  "private": true,
  "version": "0.1.0",
  "description": "Tiffin Period: Bangladeshi nostalgic childhood games (web + PWA). Phase 1.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p worker && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "serve:cf": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/baloo-da-2": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "country-flag-icons": "^1.6.20",
    "matter-js": "^0.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@playwright/test": "^1.63.0",
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "4.152.0"
  }
}
